Bootstrap: docker
From: osrf/ros:jazzy-desktop-full-noble

%labels
  Author müller.dario@ovgu.de
  Version v0.1
  Description "BA Apptainer mit ROS 2 jazzy"

%files
  ../driving_swarm_infrastructure /ros_ws

%environment
  export GDK_BACKEND=x11

%post -c /usr/bin/bash
  mkdir /ros

  export DEBIAN_FRONTEND=noninteractive

  # Basis-Tools und Voraussetzungen
  apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    sudo \
    nano \
    neovim \
    python3 \
    python3-pip \
    python3-setuptools \
    lsb-release \
    curl \
    tmux \
    htop

  apt update && apt install -y\
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-sim

  # Eclipse Zenoh Repo (trusted=yes umgehen fehlende GPG)
  echo "deb [trusted=yes] https://download.eclipse.org/zenoh/debian-repo/ /" | tee -a /etc/apt/sources.list > /dev/null
  apt update && apt-get install -y \
    zenoh-bridge-dds\
    ros-jazzy-rmw-cyclonedds-cpp

  # ROS-Erweiterungen
  apt-get install -y \
    ros-jazzy-ackermann-msgs \
    ros-jazzy-ros-gz \
    ros-jazzy-rviz2

  # CMake 3.31 installieren
  CMAKE_VERSION=3.31.0
  cd /opt
  wget https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz
  tar -xzf cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz
  ln -s /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake /usr/local/bin/cmake
  ln -s /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest /usr/local/bin/ctest
  rm cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz

  # Custom RC
  cp /root/.bashrc /customrc
  echo "source /opt/ros/jazzy/setup.bash" >> /customrc


  apt-get install -y python3-pip
  export PIP_BREAK_SYSTEM_PACKAGES=1

  # Python-Packages
  pip install numpy
  pip install pandas
  pip install scikit-image
  pip install trimesh
  pip install pycollada

  # ROS Workspace vorbereiten
  cd /ros_ws
  rosdep init || true
  rosdep update
  rosdep install --from-paths src/ --ignore-src -y

%runscript
  exec /bin/bash --rcfile bashrc
