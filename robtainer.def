Bootstrap: docker
From: osrf/ros:humble-desktop-jammy

%labels
  Author lasse.slaar@ovgu.de
  Version v0.1
  Description "MSX Apptainer with ROS 2 Humble"

%files
  ../driving_swarm_infrastructure /ros_ws

%environment
  export GDK_BACKEND=x11

%post -c /usr/bin/bash
  mkdir /ros

  export DEBIAN_FRONTEND=noninteractive

  # Basis-Tools und Voraussetzungen
  apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    sudo \
    nano \
    neovim \
    python3 \
    python3-pip \
    python3.10-venv \
    python3-distutils \
    python3-setuptools \
    lsb-release \
    curl \
    tmux \
    htop 

  # Gazebo Fortress
  echo "deb http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/gazebo-stable.list
  wget -qO - https://packages.osrfoundation.org/gazebo.key | apt-key add -
  apt-get update && apt-get install -y gazebo-fortress

  # Eclipse Zenoh Repo (trusted=yes umgehen fehlende GPG)
  echo "deb [trusted=yes] https://download.eclipse.org/zenoh/debian-repo/ /" >> /etc/apt/sources.list
  apt-get update && apt-get install -y \
    zenoh-bridge-ros2dds \
    ros-humble-rmw-cyclonedds-cpp

  # ROS-Erweiterungen
  apt-get install -y \
    ros-humble-ackermann-msgs \
    ros-humble-ros-gz \
    ros-humble-rviz2

  # CMake 3.31 installieren
  CMAKE_VERSION=3.31.0
  cd /opt
  wget https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz
  tar -xzf cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz
  ln -s /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake /usr/local/bin/cmake
  ln -s /opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest /usr/local/bin/ctest
  rm cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz

  # Custom RC
  cp /root/.bashrc /customrc
  echo "source /opt/ros/humble/setup.bash" >> /customrc

  # Python-Packages
  pip install numpy==1.23.5
  pip install pandas==1.5.3
  pip install scikit-image
  pip install trimesh
  pip install pycollada
  pip install --user --force-reinstall numpy==1.23.5
  pip install plotly
  pip install dash

  # ROS Workspace vorbereiten
  cd /ros_ws
  rosdep init || true
  rosdep update
  rosdep install --from-paths src/ --ignore-src -y

%runscript
  exec /bin/bash --rcfile /customrc
