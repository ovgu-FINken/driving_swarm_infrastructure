<?xml version="1.0"?>
<sdf version="1.7">
  <world name="default">

    <!-- ROS state plugin -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

    <!-- Light (as in your template) -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- Perfectly flat, high-grip ground plane -->
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2 2</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000</mu>
                <mu2>1000</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
              <torsional>
                <coefficient>1.0</coefficient>
                <use_patch_radius>true</use_patch_radius>
                <patch_radius>0.05</patch_radius>
                <surface_radius>0.05</surface_radius>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode>
                <kp>1e7</kp>
                <kd>1e3</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.0</restitution_coefficient>
              <threshold>1e6</threshold>
            </bounce>
          </surface>
          <max_contacts>20</max_contacts>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2 2</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <!-- Environment -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- Physics -->
    <physics type="ode" name="template_like_ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>5</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <wind/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Square room: 2 m x 2 m inside, 0.1 m thick, 0.4 m tall (Z center 0.20) -->
    <model name="wall_north">
      <static>1</static>
      <link name="link">
        <pose>0 1.0 0.20 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.0 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.1 0.4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>1</static>
      <link name="link">
        <pose>0 -1.0 0.20 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.0 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.1 0.4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>1</static>
      <link name="link">
        <pose>1.0 0 0.20 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 2.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.0 0.4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>1</static>
      <link name="link">
        <pose>-1.0 0 0.20 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 2.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.0 0.4</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- GUI: built-in top-down camera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 10 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
