<?xml version='1.0'?>
<sdf version='1.7'>
  <world name='swarmlab'>

    <!-- Basic Environment -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- Physics -->
    <gravity>0 0 -9.8</gravity>
    <atmosphere type='adiabatic'/>
    <wind/>
    <physics type='ode'>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>5</real_time_factor>
      <real_time_update_rate>2500</real_time_update_rate>
    </physics>

    <!-- Rendering -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- GPS (remove?) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Lab Model (remove) -->
    <!--
    <model name="swarmlab">
      <static>1</static>
      <include>
         <uri>model://swarmlab</uri> 
        <uri>/home/adrian/research/swarmkit_ws/src/swarmkit/platforms/turtlebot3_simulations/turtlebot3_gazebo/models/swarmlab/model.sdf</uri>
        <uri>model://swarmlab</uri>
      </include>
    </model>
    -->

    <!-- Lab Model -->
    <!-- We assume the North-Eastern corner is the origin (this is the corner closest to the TV), +x is West, +y is South -->
      <model name="wall_east">
        <static>1</static>
        <pose>0 1.5 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.05 3.0 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.05 3.0 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_south">
        <static>1</static>
        <pose>1.75 3 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>3.5 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>3.5 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_north">
        <static>1</static>
        <pose>2 0 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>4 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>4 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_west_south_y">
        <static>1</static>
        <pose>3.5 2.25 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.05 1.5 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.05 1.5 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_west_south_x">
        <static>1</static>
        <pose> 3.75 1.5 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.5 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.5 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_west_north_y">
        <static>1</static>
        <pose>4 1.25 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.05 0.5 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.05 0.5 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_triangle_x">
        <static>1</static>
        <pose>4.5 1 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>1 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>1 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_triangle_hyp">
        <static>1</static>
        <pose>4.5 0.5 0.20 0 0 0.78539816</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>1.41421356 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>1.41421356 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_obstacle_north_x">
        <static>1</static>
        <pose>0.5 1 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>1 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>1 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_obstacle_south_x">
        <static>1</static>
        <pose>1.5 2 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>1 0.05 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>1 0.05 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

      <model name="wall_obstacle_y">
        <static>1</static>
        <pose>2 1.5 0.20 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.05 1 0.4</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.05 1 0.4</size></box></geometry>
          </visual>
        </link>
      </model>

    <!-- Default Camera View -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1.08306 -4.33385 3.73164 0 0.769797 1.5722</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
